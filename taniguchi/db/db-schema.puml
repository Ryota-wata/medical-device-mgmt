@startuml
hide circle
hide methods
top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle

' 認証・ユーザー系
package "認証・ユーザー" {
  entity "feature_catalogs" as feature_catalogs {
    * 機能コード / feature_code : varchar
    --
    機能名 / feature_name : varchar
    大分類コード / category_code : varchar
    メニューグループコード / menu_group_code : varchar
    機能種別 / feature_kind : varchar
    利用文脈 / usage_context : varchar
    設定スコープ / config_scope : varchar
    表示順 / sort_order : int
    有効フラグ / is_active : boolean
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of feature_catalogs
    config_scope:
    SYSTEM_FIXED = 固定導線
    FACILITY = 施設設定のみ
    FACILITY_USER = 施設設定 + ユーザー施設別設定
    Phase1では lending_in_use_used を
    FACILITY_USER とする。
    normal_ship_request は Phase2 の
    SHIP依頼機能候補であり、
    Phase1の施設提供機能設定・
    ユーザー施設別機能設定の候補に含めない。
    lending_in_use_used の実効利用には lending_checkout も必須。
  end note

  entity "column_catalogs" as column_catalogs {
    * カラムコード / column_code : varchar
    --
    カラム名 / column_name : varchar
    関連機能コード / related_feature_code : varchar
    カラム分類コード / column_group_code : varchar
    利用文脈 / usage_context : varchar
    表示順 / sort_order : int
    有効フラグ / is_active : boolean
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  entity "users" as users {
    * ユーザーID / user_id : bigint
    --
    メールアドレス（ログインID） / email_address : varchar
    パスワードハッシュ / password_hash : varchar
    ユーザー名 / name : varchar
    設立母体ID / establishment_id : bigint
    施設ID / facility_id : bigint
    アカウント種別 / account_type : varchar
    所属部門 / department_name : varchar
    所属部署 / section_name : varchar
    役職 / position_name : varchar
    電話番号 / phone_number : varchar
    アカウント有効フラグ / is_active : boolean
    アカウントロック日時 / locked_at : timestamp
    ロック理由 / lock_reason : varchar
    最終ログイン日時 / last_login_at : timestamp
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
    削除日時 / deleted_at : timestamp
  }

  note right of users
    account_type:
    HOSPITAL = ユーザー管理画面で扱う病院ユーザー
    SHIP = SHIPユーザー管理画面で扱うSHIPユーザー
    SYSTEM_ADMIN = 共有システム管理者アカウント
    account_type は管理画面/APIの対象区分に利用し、
    通常アカウントの機能認可には使わない。
    通常アカウントの担当施設と施設別権限は
    user_facility_assignments、
    user_facility_feature_settings、
    user_facility_column_settings を正本とする。
    facility_id は既定施設を表し、
    user_facility_assignments.is_default=true の施設と同期する。
    SYSTEM_ADMIN は有効アカウント1件のみ。
    未削除の全施設・全機能・全カラムを利用可能。
    監査ログは共有アカウントの user_id として記録し、
    実利用者個人は追跡しない。
  end note

  entity "api_idempotency_records" as api_idempotency_records {
    * API冪等実行記録ID / api_idempotency_record_id : bigint
    --
    施設ID / facility_id : bigint
    ユーザーID / user_id : bigint
    HTTPメソッド / http_method : varchar
    リクエストパス / request_path : varchar
    冪等キー / idempotency_key : varchar
    リクエストハッシュ / request_hash : varchar
    処理状態 / processing_status : varchar
    応答HTTPステータス / response_status : int
    応答ボディJSON / response_body_json : json
    処理中有効期限 / in_progress_expires_at : timestamp
    結果保持期限 / expires_at : timestamp
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of api_idempotency_records
    二重作成を防止する必要があるAPIの冪等判定正本。
    UNIQUE(facility_id, user_id, http_method,
    request_path, idempotency_key) を定義する。
    processing_status: IN_PROGRESS / COMPLETED。
    request_hash は正規化済み業務項目と、
    ファイルAPIではファイル名、サイズ、MIMEタイプ、
    内容ハッシュ、保存形式、文書属性を含める。
    COMPLETED更新は業務トランザクションと
    同一トランザクションで確定する。
    response_body_json には再送時に必要な
    業務IDと結果だけを保存し、
    署名付きURL、認証情報、機微情報は保存しない。
    修理・廃棄発注登録ではIN_PROGRESS中の再開情報として、
    初回採番した発注番号と初回受付日から確定した発注日を
    response_body_json に保持し、COMPLETED時に
    正式な応答内容へ置き換える。
    業務未コミットで再実行可能な失敗となった場合も
    当該再開情報を保持し、in_progress_expires_at を
    現在日時以前へ更新して同一要求で再実行できるようにする。
    in_progress_expires_at はIN_PROGRESSの処理権取得期限とし、
    期限内の同一要求は処理中として扱う。
    期限切れ時は書込先DBの業務結果を確認したうえで
    同一要求の再実行権を取得できる。
    COMPLETED確定時は in_progress_expires_at をNULLとし、
    expires_at を成功確定から24時間以上とする。
    IN_PROGRESS中の expires_at はNULLとする。
    期限切れ行は後続処理で削除できる。
    業務履歴のidempotency_keyは監査用途とし、
    冪等判定の正本には使用しない。
  end note

  entity "user_facility_assignments" as user_facility_assignments {
    * ユーザー施設割当ID / user_facility_assignment_id : bigint
    --
    ユーザーID / user_id : bigint
    施設ID / facility_id : bigint
    割当種別 / assignment_type : varchar
    既定選択フラグ / is_default : boolean
    有効フラグ / is_active : boolean
    適用開始日 / valid_from : date
    適用終了日 / valid_to : date
    作成者ユーザーID / created_by : bigint
    更新者ユーザーID / updated_by : bigint
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of user_facility_assignments
    病院ユーザー/SHIPユーザー共通で、
    直接割り当てられた作業対象施設のみを保持する。
    ユーザー管理画面では選択中施設を必ず含め、
    選択中施設と同一設立母体の担当施設候補から設定する。
    SHIPユーザー管理画面では未削除の全施設から設定する。
    他施設閲覧グループ経由で見える施設は
    本テーブルへ展開しない。
  end note

  entity "facility_feature_settings" as facility_feature_settings {
    * 施設機能設定ID / facility_feature_setting_id : bigint
    --
    施設ID / facility_id : bigint
    機能コード / feature_code : varchar
    有効フラグ / is_enabled : boolean
    作成者ユーザーID / created_by : bigint
    更新者ユーザーID / updated_by : bigint
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of facility_feature_settings
    config_scope が FACILITY または
    FACILITY_USER の feature_code を保持する。
    FACILITY_USER はこの設定と
    user_facility_feature_settings の両方が
    ON の場合に実効利用できる。
  end note

  entity "facility_column_settings" as facility_column_settings {
    * 施設カラム設定ID / facility_column_setting_id : bigint
    --
    施設ID / facility_id : bigint
    カラムコード / column_code : varchar
    有効フラグ / is_enabled : boolean
    作成者ユーザーID / created_by : bigint
    更新者ユーザーID / updated_by : bigint
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  entity "user_facility_feature_settings" as user_facility_feature_settings {
    * ユーザー施設機能設定ID / user_facility_feature_setting_id : bigint
    --
    ユーザー施設割当ID / user_facility_assignment_id : bigint
    機能コード / feature_code : varchar
    有効フラグ / is_enabled : boolean
    作成者ユーザーID / created_by : bigint
    更新者ユーザーID / updated_by : bigint
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of user_facility_feature_settings
    病院ユーザー/SHIPユーザー共通で、
    担当施設ごとのユーザー機能利用可否を保持する。
    config_scope が FACILITY_USER の
    feature_code のみ保持する。
    施設側で有効な機能の範囲内でON/OFFできる。
    Phase1では lending_in_use_used も
    FACILITY_USER として保持する。
    normal_ship_request は Phase2 対象のため
    Phase1のユーザー施設別管理対象に含めない。
  end note

  entity "user_facility_column_settings" as user_facility_column_settings {
    * ユーザー施設カラム設定ID / user_facility_column_setting_id : bigint
    --
    ユーザー施設割当ID / user_facility_assignment_id : bigint
    カラムコード / column_code : varchar
    有効フラグ / is_enabled : boolean
    作成者ユーザーID / created_by : bigint
    更新者ユーザーID / updated_by : bigint
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of user_facility_column_settings
    病院ユーザー/SHIPユーザー共通で、
    担当施設ごとのユーザー表示カラム可否を保持する。
    施設側で有効なカラムの範囲内でON/OFFできる。
  end note

  entity "user_remember_tokens" as user_remember_tokens {
    * トークンID / token_id : bigint
    --
    ユーザーID / user_id : bigint
    記憶トークン / token : varchar
    有効期限 / expires_at : timestamp
    最終ログイン状態復元日時 / last_used_at : timestamp
    作成日時 / created_at : timestamp
  }

  entity "password_reset_tokens" as password_reset_tokens {
    * トークンID / token_id : bigint
    --
    ユーザーID / user_id : bigint
    リセットトークン / token : varchar
    有効期限 / expires_at : timestamp
    使用日時 / used_at : timestamp
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }
}

' 施設・ロケーション系
package "施設・ロケーション" {
  entity "establishments" as establishments {
    * 設立母体ID / establishment_id : bigint
    --
    設立母体名 / establishment_name : varchar
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
    削除日時 / deleted_at : timestamp
  }

  entity "facilities" as facilities {
    * 施設ID / facility_id : bigint
    --
    設立母体ID / establishment_id : bigint
    医療機関コード / facility_code : varchar
    施設名 / facility_name : varchar
    都道府県 / prefecture : varchar
    総病床数 / bed_count : int(7)
    システム利用契約状態 / system_contract_status : varchar
    システム利用契約終了日 / system_contract_ended_on : date
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
    削除日時 / deleted_at : timestamp
  }

  entity "施設詳細" as facility_details {
    * 施設ID / facility_id : bigint
    --
    市区町村 / city : varchar
    二次医療圏名 / secondary_medical_area_name : varchar
    建替年度 / rebuild_fiscal_year : char(4)
    建物面積 / building_area : decimal(12,2)
    救命救急センター認定 / emergency_center_certified : boolean
    2次救急・3次救急病院認定区分 / emergency_hospital_certification_type : varchar
    周産期母子医療センター認定区分 / perinatal_center_certification_type : varchar
    災害拠点病院認定 / disaster_base_hospital_certified : boolean
    がん診療連携拠点病院認定 / cancer_regional_base_hospital_certified : boolean
    地域医療支援病院認定 / regional_medical_support_hospital_certified : boolean
    救急初療室数 / emergency_initial_care_room_count : int
    中央処置ベッド数 / central_treatment_bed_count : int
    化学療法ベッド数 / chemotherapy_bed_count : int
    分娩室数 / delivery_room_count : int
    内視鏡室数 / endoscopy_room_count : int
    人工透析ベッド数 / dialysis_bed_count : int
    手術室数 / operating_room_count : int
    中央採血台数 / central_blood_collection_unit_count : int
    救急病棟病床数 / emergency_ward_bed_count : int
    E-ICU病床数 / eicu_bed_count : int
    ICU病床数 / icu_bed_count : int
    HCU病床数 / hcu_bed_count : int
    G-ICU病床数 / gicu_bed_count : int
    CCU病床数 / ccu_bed_count : int
    SCU病床数 / scu_bed_count : int
    NICU病床数 / nicu_bed_count : int
    GCU病床数 / gcu_bed_count : int
    MFICU病床数 / mficu_bed_count : int
    一般病床数 / general_bed_count : int
    一般病床（無菌病棟）数 / clean_room_bed_count : int
    一般病床（緩和ケア）数 / palliative_care_bed_count : int
    一般病床（回復期リハ）数 / rehabilitation_bed_count : int
    一般病床（地域包括ケア）数 / community_care_bed_count : int
    療養病床数 / chronic_care_bed_count : int
    精神病床数 / psychiatric_bed_count : int
    感染症・結核病床数 / infectious_tuberculosis_bed_count : int
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of facility_details
    SHIP施設マスタ画面の一覧固定カラムのうち、
    facilities の中核項目以外を1施設1行で保持する。
    facility_id は facilities.facility_id と同値の
    PK兼FKとし、詳細行の独自採番は持たない。
    総病床数は facilities.bed_count を正本とする。
    2次/3次救急と周産期母子医療センターは
    区分値を保持し、それ以外の認定は boolean とする。
    一覧・新規作成・編集で扱う固定カラムは
    すべて必須入力とし、NULL 不可として保持する。
    諸室数・病床内訳の 0 は明示的になしとして扱う。
    施設削除状態は facilities.deleted_at で管理し、
    本テーブルには削除日時を持たない。
  end note

  entity "facility_collaboration_groups" as facility_collaboration_groups {
    * 施設協業グループID / facility_collaboration_group_id : bigint
    --
    グループ名 / group_name : varchar
    有効フラグ / is_active : boolean
    作成者ユーザーID / created_by : bigint
    更新者ユーザーID / updated_by : bigint
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  entity "facility_collaboration_group_facilities" as facility_collaboration_group_facilities {
    * 施設協業グループ所属施設ID / facility_collaboration_group_facility_id : bigint
    --
    施設協業グループID / facility_collaboration_group_id : bigint
    施設ID / facility_id : bigint
    作成者ユーザーID / created_by : bigint
    更新者ユーザーID / updated_by : bigint
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  entity "facility_external_view_settings" as facility_external_view_settings {
    * 他施設公開データ設定ID / facility_external_view_setting_id : bigint
    --
    公開元施設ID / provider_facility_id : bigint
    共有データ種別 / sharing_data_type : varchar
    有効フラグ / is_enabled : boolean
    作成者ユーザーID / created_by : bigint
    更新者ユーザーID / updated_by : bigint
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  entity "facility_external_column_settings" as facility_external_column_settings {
    * 他施設公開カラム設定ID / facility_external_column_setting_id : bigint
    --
    公開元施設ID / provider_facility_id : bigint
    カラムコード / column_code : varchar
    有効フラグ / is_enabled : boolean
    作成者ユーザーID / created_by : bigint
    更新者ユーザーID / updated_by : bigint
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of facility_collaboration_groups
    任意の施設グループで
    他施設閲覧候補を定義する。
    実際に何を見せるかは
    facility_external_view_settings /
    facility_external_column_settings
    で制御する。
  end note

  entity "facility_locations" as facility_locations {
    * 施設ロケーションID / facility_location_id : bigint
    --
    施設ID / facility_id : bigint
    施設側部門ID / division_id : varchar
    施設側部署ID / department_id : varchar
    施設側諸室ID / room_id : varchar
    棟 / building : varchar
    階 / floor : varchar
    部門名 / department_name : varchar
    部署名 / section_name : varchar
    室名称 / room_name : varchar
    SHIP部署ID / ship_department_id : bigint
    SHIP諸室区分ID / ship_room_category_id : bigint
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
    削除日時 / deleted_at : timestamp
  }

  note right of facility_locations
    現有品調査・調査登録内容修正の
    部門/部署候補の正本。
    資産一覧の管理部署編集候補も
    department_id 非NULLの
    active 行を department_id 単位で
    重複排除して利用する。
    棟/階は施設により NULL 可。
    室名は候補表示に使うが、
    画面では自由記述も許容する。
    同一施設・同一 department_id では
    department_name / section_name の
    不一致を許容しない。
    section_name の施設内重複は許容し、
    候補表示では department_name /
    section_name で識別する。
  end note

  entity "ship_departments" as ship_departments {
    * SHIP部署ID / ship_department_id : bigint
    --
    部門名 / division_name : varchar
    部署名 / department_name : varchar
    並び順 / sort_order : int
    有効フラグ / is_active : boolean
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of ship_departments
    個別部署マスタとの関係は 1:1 ではない。
    1つの SHIP部署に複数の facility_locations が
    紐づくことを許容する。
    共通マスタとして並び替え・絞り込み・
    標準候補に利用する。
  end note

  entity "ship_room_categories" as ship_room_categories {
    * SHIP諸室区分ID / ship_room_category_id : bigint
    --
    諸室区分1 / room_category1 : varchar
    諸室区分2 / room_category2 : varchar
    並び順 / sort_order : int
    有効フラグ / is_active : boolean
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  entity "facility_location_remodels" as facility_location_remodels {
    * 施設ロケーションリモデルID / facility_location_remodel_id : bigint
    --
    施設ロケーションID / facility_location_id : bigint
    新SHIP部署ID / target_ship_department_id : bigint
    新SHIP諸室区分ID / target_ship_room_category_id : bigint
    新棟 / target_building : varchar
    新階 / target_floor : varchar
    新部門名 / target_department_name : varchar
    新部署名 / target_section_name : varchar
    新室名称 / target_room_name : varchar
    新室数 / target_room_count : int
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
    削除日時 / deleted_at : timestamp
  }

}

' 資産マスタ・分類系
package "資産マスタ・分類" {
  entity "asset_categories" as asset_categories {
    * カテゴリID / category_id : bigint
    --
    カテゴリ名 / category_name : varchar
    並び順 / sort_order : int
    有効フラグ / is_active : boolean
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  entity "asset_large_classes" as asset_large_classes {
    * 大分類ID / large_class_id : bigint
    --
    カテゴリID / category_id : bigint
    大分類名 / large_class_name : varchar
    並び順 / sort_order : int
    有効フラグ / is_active : boolean
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  entity "asset_medium_classes" as asset_medium_classes {
    * 中分類ID / medium_class_id : bigint
    --
    大分類ID / large_class_id : bigint
    中分類名 / medium_class_name : varchar
    並び順 / sort_order : int
    有効フラグ / is_active : boolean
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  entity "asset_items" as asset_items {
    * 品目ID / asset_item_id : bigint
    --
    中分類ID / medium_class_id : bigint
