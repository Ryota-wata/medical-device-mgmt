' QRコード
package "QRコード" {
  entity "qr_codes" as qr_codes {
    * QRコードID / qr_code_id : bigint
    --
    資産台帳ID / asset_ledger_id : bigint
    施設ID / facility_id : bigint
    QR識別子 / qr_identifier : varchar
    コードプレフィックス / code_prefix : char(1)
    コード枝番（2桁） / code_branch : char(2)
    コード連番（5桁） / code_serial : int
    発行種別 / issue_type : varchar
    テンプレートキー / label_template_key : varchar
    フリー記入項目 / free_entry_text : varchar
    最終発行者ユーザーID / issued_by_user_id : bigint
    最終発行日時 / issued_at : timestamp
    印刷状態 / print_status : varchar
    最終印刷ジョブID / last_print_job_id : bigint
    最終印刷日時 / printed_at : timestamp
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
    削除日時 / deleted_at : timestamp
  }

  note right of qr_codes
    UNIQUE(facility_id, qr_identifier)
    UNIQUE(facility_id, code_prefix, code_branch, code_serial)
    code_serial is assigned as max + 1 per
    (facility_id, code_prefix, code_branch)
    in a server-side transaction
    data matching confirm resolves
    (facility_id, qr_identifier) and updates
    qr_codes.asset_ledger_id in same tx
    label_template_key refers to
    frontend-fixed Tepra Creator templates
    latest print operator is resolved via
    last_print_job_id -> qr_print_jobs.requested_by_user_id
  end note

  entity "qr_print_jobs" as qr_print_jobs {
    * 印刷ジョブID / qr_print_job_id : bigint
    --
    施設ID / facility_id : bigint
    テンプレートキー / template_key : varchar
    プリンタ名 / printer_name : varchar
    クライアント要求ID / client_request_id : varchar
    要求比較用ハッシュ / request_payload_hash : char
    実行者ユーザーID / requested_by_user_id : bigint
    依頼日時 / requested_at : timestamp
    開始日時 / started_at : timestamp
    終了日時 / finished_at : timestamp
    ステータス / status : varchar
    成功件数 / success_count : int
    失敗件数 / failure_count : int
    エラー段階 / error_stage : varchar
    エラー概要 / error_summary : varchar
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of qr_print_jobs
    UNIQUE(requested_by_user_id, facility_id, client_request_id)
    request_payload_hash stores
    the normalized print-start
    request payload hash used for
    idempotent replay comparison.
    started_at is recorded when
    print-start acceptance completes
    and the client can hand off to
    the local print module.
    error_stage stores where the
    local print flow failed, e.g.
    LOCAL_MODULE_INIT /
    PRINTER_INIT /
    PRINT_REQUEST /
    PRINT_EXECUTION
  end note

  entity "qr_print_job_items" as qr_print_job_items {
    * 印刷ジョブ明細ID / qr_print_job_item_id : bigint
    --
    印刷ジョブID / qr_print_job_id : bigint
    QRコードID / qr_code_id : bigint
    印刷順 / print_order : int
    ステータス / status : varchar
    印刷日時 / printed_at : timestamp
    エラーメッセージ / error_message : varchar
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of qr_print_job_items
    PRINTED requires printed_at and
    no error_message.
    FAILED requires error_message and
    no printed_at.
    CANCELED allows optional
    error_message and no printed_at.
    qrContentUrl is not persisted and
    is derived from base URL,
    facility_id, and qr_identifier.
  end note
}

' 編集リスト
package "編集リスト" {
  entity "edit_lists" as edit_lists {
    * 編集リストID / edit_list_id : bigint
    --
    編集リスト名 / list_name : varchar
    作成者ユーザーID / created_by_user_id : bigint
    主施設ID / primary_facility_id : bigint
    リスト種別 / list_type : varchar
    ステータス / status : varchar
    最終アクセス日時 / last_accessed_at : timestamp
    クローズ日時 / closed_at : timestamp
    クローズ実行者ユーザーID / closed_by_user_id : bigint
    クローズ備考 / close_note : varchar
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
    削除日時 / deleted_at : timestamp
  }

  note right of edit_lists
    list_type は作成導線で決定する。
    通常編集リスト導線・購入管理タブから
    作成するリストは PURCHASE、
    リモデル編集リスト導線・
    リモデル管理起点は REMODEL とする。
    作成後の通常/リモデル切替や
    list_type変更APIは提供しない。
    status=CLOSED はリモデル管理の
    原本反映完了後の読み取り専用状態。
    deleted_at 設定時は選択候補・
    編集対象から除外するが、RFQ、
    申請、見積、履歴は削除せず
    edit_list_id の参照を保持する。
  end note

  entity "edit_list_work_locks" as edit_list_work_locks {
    * 編集リスト作業ロックID / edit_list_work_lock_id : bigint
    --
    編集リストID / edit_list_id : bigint
    ロック保持ユーザーID / locked_by_user_id : bigint
    ロックトークン / lock_token : varchar
    ロック取得日時 / locked_at : timestamp
    最終heartbeat日時 / last_heartbeat_at : timestamp
    ロック有効期限 / lock_expires_at : timestamp
    解除日時 / released_at : timestamp
    解除理由 / release_reason : varchar
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of edit_list_work_locks
    編集リスト単位の作業ロックを
    DBで管理する運用状態テーブル。
    有効ロックは released_at IS NULL
    かつ lock_expires_at > 現在時刻。
    heartbeatまたは編集系API成功時に
    last_heartbeat_at と lock_expires_at を更新する。
    lock_token は編集系API検証に用いる。
    強制解除機能は提供しない。
    解除済み・期限切れ行は長期保管せず
    定期削除対象とする。
  end note

  entity "edit_list_facilities" as edit_list_facilities {
    * 編集リスト対象施設ID / edit_list_facility_id : bigint
    --
    編集リストID / edit_list_id : bigint
