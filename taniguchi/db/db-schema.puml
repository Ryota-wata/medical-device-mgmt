' 棚卸
package "棚卸" {
  entity "inventory_sessions" as inventory_sessions {
    * 棚卸しセッションID / inventory_session_id : bigint
    --
    施設ID / facility_id : bigint
    セッション状態 / session_status : varchar
    棚卸し基準日 / inventory_base_date : date
    対象件数 / total_item_count : int
    確認済件数 / confirmed_item_count : int
    要対応件数 / action_required_count : int
    排他制御版 / lock_version : bigint
    作成者ユーザーID / created_by_user_id : bigint
    完了者ユーザーID / completed_by_user_id : bigint
    完了日時 / completed_at : timestamp
    取消者ユーザーID / canceled_by_user_id : bigint
    取消日時 / canceled_at : timestamp
    取消理由 / cancel_reason : varchar
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of inventory_sessions
    施設単位の棚卸しプロセスヘッダ。
    session_status:
    IN_PROGRESS / COMPLETED / CANCELLED。
    IN_PROGRESS は施設ごとに1件のみ。
    同施設の権限ユーザーは
    同じセッションを共有して作業する。
    画面を開いたユーザー単位の
    排他ロックは持たない。
    `lock_version` は完了/取消時の
    競合検知に使用し、
    更新成功時に +1 する。
  end note

  entity "inventory_items" as inventory_items {
    * 棚卸し明細ID / inventory_item_id : bigint
    --
    棚卸しセッションID / inventory_session_id : bigint
    施設ID / facility_id : bigint
    資産台帳ID / asset_ledger_id : bigint
    行番号 / line_no : int
    棚卸し状態 / inventory_status : varchar
    現施設ロケーションID / source_facility_location_id : bigint
    現設置棟 / source_building_name : varchar
    現設置フロア / source_floor_name : varchar
    現設置部門 / source_department_name : varchar
    現設置部署 / source_section_name : varchar
    現設置室名 / source_room_name : varchar
    移動先施設ロケーションID / destination_facility_location_id : bigint
    移動先棟 / destination_building_name : varchar
    移動先フロア / destination_floor_name : varchar
    移動先部門 / destination_department_name : varchar
    移動先部署 / destination_section_name : varchar
    移動先室名 / destination_room_name : varchar
    移動理由 / transfer_reason : varchar
    廃棄理由コード / disposal_reason_code : varchar
    廃棄理由詳細 / disposal_reason_text : varchar
    要対応コメント / action_required_comment : varchar
    自動起票申請ID / generated_application_id : bigint
    自動起票申請明細ID / generated_application_asset_id : bigint
    最終更新者ユーザーID / updated_by_user_id : bigint
    確定日時 / confirmed_at : timestamp
    排他制御版 / lock_version : bigint
    作成日時 / created_at : timestamp
    更新日時 / updated_at : timestamp
  }

  note right of inventory_items
    セッション開始時に対象資産ごとに
    UNCHECKED 明細を生成する。
    inventory_status:
    UNCHECKED / CONFIRMED /
    TRANSFER_PLANNED / DISPOSAL_PLANNED /
    ACTION_REQUIRED。
    CONFIRMED は現状維持、
    TRANSFER_PLANNED は移動予定、
    DISPOSAL_PLANNED は廃棄予定を表す。
    棚卸し完了時に TRANSFER_PLANNED /
    DISPOSAL_PLANNED から申請を自動起票する。
    `lock_version` は明細1行単位の
    楽観ロック用。
    更新APIは expectedLockVersion と比較し、
    不一致なら 409 を返して
    他ユーザー更新を上書きしない。
    UNIQUE(inventory_session_id, asset_ledger_id)
    で同一セッション内の二重生成を禁止する。
  end note

  entity "inventory_item_status_histories" as inventory_item_status_histories {
    * 棚卸し明細状態履歴ID / inventory_item_status_history_id : bigint
    --
    棚卸しセッションID / inventory_session_id : bigint
    棚卸し明細ID / inventory_item_id : bigint
    変更前状態 / from_inventory_status : varchar
    変更後状態 / to_inventory_status : varchar
    変更前値JSON / before_values_json : json
    変更後値JSON / after_values_json : json
    変更者ユーザーID / changed_by_user_id : bigint
    変更日時 / changed_at : timestamp
    変更理由 / change_reason : varchar
  }

  note right of inventory_item_status_histories
    棚卸し明細の状態変更監査。
    個別更新、一括更新、
    完了時の自動起票紐づけ更新で
    履歴を作成する。
  end note
}

